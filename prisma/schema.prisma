// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolUsuario {
  TRABAJADOR
  EMPRESA
  ADMIN
}

enum TipoSalario {
  HORA
  JORNADA
  MES
}

enum EstadoOferta {
  ACTIVA
  CERRADA
}

enum EstadoSolicitud {
  SOLICITADO
  VISTO
  CONTRATADO
  DESCARTADO
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  rol          RolUsuario
  createdAt    DateTime   @default(now())

  perfilTrabajador PerfilTrabajador?
  empresa          Empresa?
}

model PerfilTrabajador {
  id               String @id @default(cuid())
  nombre           String
  apellidos        String
  telefono         String
  poblacion        String
  provincia        String
  oficioPrincipal  String
  aniosExperiencia Int

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  solicitudes Solicitud[]
}

model Empresa {
  id              String @id @default(cuid())
  razonSocial     String
  cif             String @unique
  personaContacto String
  telefono        String

  usuarioId String  @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ofertas Oferta[]
}

model Oferta {
  id            String       @id @default(cuid())
  titulo        String
  oficio        String
  numeroPuestos Int
  descripcion   String
  poblacion     String
  provincia     String
  fechaInicio   DateTime
  duracionDias  Int
  salario       Decimal      @db.Decimal(10, 2)
  tipoSalario   TipoSalario
  estado        EstadoOferta @default(ACTIVA)
  publicadaEn   DateTime     @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  solicitudes Solicitud[]
}

model Solicitud {
  id       String          @id @default(cuid())
  mensaje  String?
  estado   EstadoSolicitud @default(SOLICITADO)
  creadaEn DateTime        @default(now())

  ofertaId String
  oferta   Oferta @relation(fields: [ofertaId], references: [id])

  trabajadorId String
  trabajador   PerfilTrabajador @relation(fields: [trabajadorId], references: [id])

  @@unique([ofertaId, trabajadorId])
}
